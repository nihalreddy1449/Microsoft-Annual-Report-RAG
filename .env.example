# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# This file (.env.example) IS committed - keep placeholders only, never real secrets.

# Groq API key for the generation step (Step 9).
# Get one free at https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=gsk_your_key_here

# Model used to generate answers.
GROQ_MODEL=openai/gpt-oss-120b

# Separate model used by the LLM-as-judge in the eval harness (Step 11).
# Deliberately different from GROQ_MODEL to avoid self-preference bias.
GROQ_JUDGE_MODEL=qwen/qwen3.8-27b
